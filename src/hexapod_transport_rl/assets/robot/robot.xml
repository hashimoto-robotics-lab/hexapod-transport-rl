      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="dark"/>
      </default>
      <default class="collision">
        <geom group="3" type="box" contype="1" conaffinity="1"/>
        <!-- per-link primitives (identical for the six legs, expressed in each link frame) -->
        <default class="coxa_mount"><geom type="box" size="0.0176 0.0143 0.024" pos="-0.0064 0 0.001"/></default>
        <default class="coxa0"><geom type="box" size="0.0275 0.0223 0.0184" pos="0.0595 -0.0012 0"/></default>
        <default class="coxa1"><geom type="box" size="0.0175 0.012 0.023" pos="0.0145 0 0.001"/></default>
        <default class="femur0"><geom type="box" size="0.033 0.023 0.0101" pos="0.03 0 0"/></default>
        <default class="tibia0"><geom type="box" size="0.0255 0.0217 0.0143" pos="0.0145 -0.0017 0"/></default>
        <default class="tibia1"><geom type="capsule" size="0.007" fromto="0.04 0 0 0.088 0 0"/></default>
        <default class="foot"><geom type="sphere" size="0.005" pos="0.10525 0 0"/></default>
      </default>
    </default>
  </default>

