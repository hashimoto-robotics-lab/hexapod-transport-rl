<mujoco model="sixtrail1">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <default>
    <default class="sixtrail1">
      <!-- joint conventions: coxa about +z (yaw), femur/tibia about +y (positive = leg down) -->
      <default class="coxa_joint"><joint axis="0 0 1" range="-1.5708 1.5708"/></default>
      <default class="femur_joint"><joint axis="0 1 0" range="-2.0944 2.0944"/></default>  <!-- widened from ±90°: hardware home stance has femur ~105° down (2026-09-02) -->
